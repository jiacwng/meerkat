    given-names: Jiacheng
    email: jiacheng.wang@eurecom.fr
    affiliation: EURECOM
license: MIT
repository-code: 'https://github.com/jiacwng/meerkat'
keywords:
  - alert triage
  - security operations center
  - intrusion detection
  - alert prioritization
  - machine learning
  - security operations
  - MITRE ATT&CK
  - Wazuh
  - Suricata
  - log anomaly detection
references:
