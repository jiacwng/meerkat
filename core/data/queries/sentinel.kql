// Incidents of the last 90 days in the columns meerkat reads, one row per alert and entity.
// Run it in the Microsoft Sentinel workspace, export the result as CSV, load it with the source sentinel.
let window = 90d;
let incidents = SecurityIncident
    | where TimeGenerated > ago(window)
    | summarize arg_max(TimeGenerated, *) by IncidentNumber
    | mv-expand AlertId = AlertIds to typeof(string)
    | project IncidentNumber, Classification, IncidentSeverity = Severity, IncidentUrl, AlertId;
SecurityAlert
| where TimeGenerated > ago(window)
| summarize arg_max(TimeGenerated, *) by SystemAlertId
| join kind=inner incidents on $left.SystemAlertId == $right.AlertId
| extend RuleIds = todynamic(tostring(todynamic(ExtendedProperties)["Analytic Rule Ids"]))
| extend Found = todynamic(Entities)
| mv-expand Entity = iff(array_length(Found) > 0, Found, dynamic([{}]))
| extend Kind = tolower(tostring(Entity.Type))
| project
    IncidentId = tostring(IncidentNumber),
    Timestamp = strcat(format_datetime(TimeGenerated, "yyyy-MM-dd"), "T", format_datetime(TimeGenerated, "HH:mm:ss"), "Z"),
    DetectorId = coalesce(tostring(RuleIds[0]), AlertType),
    IncidentGrade = Classification,
    AlertTitle = AlertName,
    Category = Tactics,
    Severity = IncidentSeverity,
    IncidentUrl,
    MitreTechniques = replace_string(replace_regex(Techniques, @'[\[\]" ]', ""), ",", ";"),
    DeviceName = iff(Kind == "host", tostring(Entity.HostName), ""),
    DeviceId = iff(Kind == "host", tostring(Entity.AzureID), ""),
    AccountName = iff(Kind == "account", tostring(Entity.Name), ""),
    AccountUpn = iff(Kind == "account" and isnotempty(Entity.UPNSuffix), strcat(Entity.Name, "@", Entity.UPNSuffix), ""),
    AccountSid = iff(Kind == "account", tostring(Entity.Sid), ""),
    IpAddress = iff(Kind == "ip", tostring(Entity.Address), ""),
    Sha256 = iff(Kind == "filehash" and tostring(Entity.Algorithm) =~ "SHA256", tostring(Entity.Value), ""),
    Url = iff(Kind == "url", tostring(Entity.Url), "")
